# Copy to .env (next to docker-compose.yml) and fill in.

# SQL Server sa password: at least 8 chars with upper, lower, digit and symbol.
# Do not use ";" (it would break the connection string).
MSSQL_SA_PASSWORD=Redmine@12345

# JWT signing key, at least 32 characters.
JWT_KEY=change-me-to-a-random-string-of-32-chars-or-more

# Optional: Azure Communication Services, needed only to email passwords to new users.
AZURE_EMAIL_CONNECTION_STRING=

# Optional port overrides
# DB_PORT=1434
# BACKEND_PORT=5164
# FRONTEND_PORT=3000
# VITE_API_URL=http://localhost:5164/api
